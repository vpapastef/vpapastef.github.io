---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fileSize, archive, formatBytes } from '../../lib/teaching';

export async function getStaticPaths() {
  const modules = await getCollection('teaching', ({ data }) => !data.draft);
  return modules.map((m) => ({ params: { module: m.id }, props: { module: m } }));
}

const { module } = Astro.props;
const d = module.data;
const el = d.el;

const bilingual = Boolean(el && (el.syllabus.length || el.title));

const en = {
  title: d.title,
  code: d.code,
  place: [d.department, d.institution].filter(Boolean).join(' · '),
  when: [d.semester, d.term].filter(Boolean).join(' · '),
  summary: d.summary,
  syllabus: d.syllabus,
};
const gr = {
  title: el?.title ?? d.title,
  code: el?.code ?? d.code,
  place: [el?.department ?? d.department, el?.institution ?? d.institution]
    .filter(Boolean).join(' · '),
  when: [el?.semester ?? d.semester, d.term].filter(Boolean).join(' · '),
  summary: el?.summary ?? d.summary,
  syllabus: el?.syllabus?.length ? el.syllabus : d.syllabus,
};

const bold = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

// The three PDFs of a week. Each is listed only when the frontmatter names it
// and the file is in public/, so publishing one is a one-line change.
const KINDS = [
  { key: 'file', part: 'lecture', el: 'Θεωρία', en: 'Theory', elNote: 'οι διαφάνειες που είδαμε μέσα στην εβδομάδα', enNote: 'the slides we went through during the week' },
  { key: 'summary', part: 'summary', el: 'Σύνοψη', en: 'Summary', elNote: 'η σύνοψη της θεωρίας σε λίγες διαφάνειες', enNote: 'the theory summarised in a few slides' },
  { key: 'exercises', part: 'exercises', el: 'Ασκήσεις', en: 'Exercises', elNote: 'λυμένες ασκήσεις για εξάσκηση', enNote: 'solved exercises for practice' },
] as const;

const rows = [...d.lectures]
  .sort((a, b) => a.n - b.n)
  .map((l) => {
    const items = KINDS.map((k) => {
      const file = l[k.key];
      const size = file ? fileSize(module.id, file) : null;
      return { ...k, href: file && size !== null ? `/teaching/${module.id}/${file}` : null, size };
    });
    const bundle = archive(module.id, `week-${String(l.week ?? l.n).padStart(2, '0')}`);
    return { ...l, items, any: items.some((i) => i.href), bundle };
  });
const files = rows.reduce((n, r) => n + r.items.filter((i) => i.href).length, 0);
const zip = archive(module.id);
const kinds = KINDS.map((k) => ({ ...k, zip: archive(module.id, k.part) }));
---

<BaseLayout
  title={en.title}
  description={en.summary ?? `${en.title} (${en.code}) at ${d.institution}.`}
  wide
>
  <div class="flex items-baseline justify-between gap-4">
    <a href="/teaching/" class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
      ← Teaching
    </a>
    {bilingual && (
      <button
        type="button"
        id="lang-toggle"
        class="shrink-0 rounded-md border border-gray-300 px-3 py-1 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800"
      >
        EN
      </button>
    )}
  </div>

  <header class="mt-4 border-b border-gray-200 pb-6 dark:border-gray-800">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">
        <span data-lang="en" hidden>{en.title}</span><span data-lang="el">{gr.title}</span>
      </h1>
      <span class="shrink-0 text-sm font-medium text-gray-500 dark:text-gray-400">
        <span data-lang="en" hidden>{en.code}</span><span data-lang="el">{gr.code}</span>
      </span>
    </div>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
      <span data-lang="en" hidden>{en.place}</span><span data-lang="el">{gr.place}</span>
    </p>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      <span data-lang="en" hidden>{en.when}</span><span data-lang="el">{gr.when}</span>
    </p>
  </header>

  <div role="tablist" aria-label="Sections" class="mt-6 flex flex-wrap gap-3">
    <button
      type="button" role="tab" id="tab-syllabus" aria-controls="panel-syllabus" aria-selected="true"
      class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <span data-lang="en" hidden>Syllabus</span><span data-lang="el">Ύλη</span>
    </button>
    <button
      type="button" role="tab" id="tab-slides" aria-controls="panel-slides" aria-selected="false"
      class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <span data-lang="en" hidden>Material</span><span data-lang="el">Υλικό</span>
    </button>
  </div>

  <section id="panel-syllabus" role="tabpanel" aria-labelledby="tab-syllabus" class="mt-8 max-w-3xl">
    <div data-lang="en" hidden class="mt-6 space-y-4">
      {en.syllabus.map((para) => (
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed" set:html={bold(para)} />
      ))}
    </div>
    <div data-lang="el" class="mt-6 space-y-4">
      {gr.syllabus.map((para) => (
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed" set:html={bold(para)} />
      ))}
    </div>
  </section>

  <section id="panel-slides" role="tabpanel" aria-labelledby="tab-slides" class="mt-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <dl class="grid grid-cols-[auto_1fr_auto] gap-x-3 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
        {kinds.map((k) => (
          <>
            <dt class="font-medium text-gray-900 dark:text-gray-100">
              <span data-lang="en" hidden>{k.en}</span><span data-lang="el">{k.el}</span>
            </dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <span data-lang="en" hidden>{k.enNote}</span><span data-lang="el">{k.elNote}</span>
            </dd>
            <dd class="whitespace-nowrap sm:hidden">
              {k.zip && (
                <a href={k.zip.href} download class="text-gray-700 transition-colors hover:text-accent dark:text-gray-300 dark:hover:text-accent-dark">
                  <svg class="inline-block align-[-4px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                  <span class="sr-only"><span data-lang="en" hidden>{k.en}, all weeks</span><span data-lang="el">{k.el}, όλες οι εβδομάδες</span></span>
                  <span class="text-xs text-gray-400 dark:text-gray-500">{formatBytes(k.zip.size)}</span>
                </a>
              )}
            </dd>
          </>
        ))}
      </dl>
      {zip && (
        <a
          href={zip.href}
          download
          class="shrink-0 self-start rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300"
        >
          <span data-lang="en" hidden>Download all ({files} files, {formatBytes(zip.size)})</span>
          <span data-lang="el">Λήψη όλων ({files} αρχεία, {formatBytes(zip.size)})</span>
        </a>
      )}
    </div>

    {rows.length === 0 ? (
      <p class="mt-6 text-gray-600 dark:text-gray-400">
        <span data-lang="en" hidden>Material will appear here as the course runs.</span>
        <span data-lang="el">Το υλικό θα αναρτάται καθώς προχωρά το μάθημα.</span>
      </p>
    ) : (
      <div class="mt-8">
        <div class="hidden border-b border-gray-200 pb-2 text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400 sm:grid sm:grid-cols-[1fr_repeat(3,4.5rem)] sm:items-end sm:gap-x-3">
          <span></span>
          {kinds.map((k) => (
            <span class="flex flex-col items-center gap-1">
              <span><span data-lang="en" hidden>{k.en}</span><span data-lang="el">{k.el}</span></span>
              {k.zip && (
                <a href={k.zip.href} download class="font-normal text-gray-700 transition-colors hover:text-accent dark:text-gray-300 dark:hover:text-accent-dark">
                  <svg class="inline-block align-[-4px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                  <span class="sr-only"><span data-lang="en" hidden>{k.en}, all weeks</span><span data-lang="el">{k.el}, όλες οι εβδομάδες</span></span>
                  <span class="text-gray-400 dark:text-gray-500">{formatBytes(k.zip.size)}</span>
                </a>
              )}
            </span>
          ))}
        </div>
        <ol class="divide-y divide-gray-100 dark:divide-gray-900">
          {rows.map((r) => (
            <li class="py-3 sm:grid sm:grid-cols-[1fr_repeat(3,4.5rem)] sm:items-baseline sm:gap-x-3">
              <span class="text-gray-900 dark:text-gray-100">
                <span class="text-gray-500 dark:text-gray-400">
                  <span data-lang="en" hidden>Week {r.week ?? r.n}</span
                  ><span data-lang="el">Εβδομάδα {r.week ?? r.n}</span>
                </span>
                {' — '}<span data-lang="en" hidden>{r.titleEn ?? r.title}</span><span data-lang="el">{r.title}</span>
                {r.bundle && (
                  <a href={r.bundle.href} download class="ml-2 hidden whitespace-nowrap rounded-md sm:inline-block border border-gray-300 px-2 py-0.5 text-sm text-gray-700 transition-colors hover:border-accent hover:text-accent dark:border-gray-700 dark:text-gray-300 dark:hover:border-accent-dark dark:hover:text-accent-dark">
                    <svg class="inline-block align-[-4px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                    <span><span data-lang="en" hidden>All</span><span data-lang="el">Όλα</span></span>
                    <span class="text-xs text-gray-400 dark:text-gray-500">{formatBytes(r.bundle.size)}</span>
                  </a>
                )}
              </span>
              {r.any ? (
                <div class="mt-2 flex flex-wrap gap-2 sm:contents">
                  {r.items.map((it) => it.href ? (
                    <a
                      href={it.href}
                      target="_blank"
                      rel="noopener"
                      class="rounded-md border border-gray-300 px-2.5 py-1 text-sm text-gray-700 transition-colors hover:border-accent hover:text-accent dark:border-gray-700 dark:text-gray-300 dark:hover:border-accent-dark dark:hover:text-accent-dark sm:border-0 sm:px-0 sm:py-0 sm:text-center"
                    >
                      <svg class="inline-block align-[-4px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                      <span class="sm:sr-only"><span data-lang="en" hidden>{it.en}</span><span data-lang="el">{it.el}</span></span>
                      {it.size !== null && (
                        <span class="text-xs text-gray-400 dark:text-gray-500">{formatBytes(it.size)}</span>
                      )}
                    </a>
                  ) : (
                    <span class="rounded-md border border-dashed border-gray-200 px-2.5 py-1 text-sm text-gray-400 dark:border-gray-800 dark:text-gray-600 sm:border-0 sm:px-0 sm:py-0 sm:text-center">
                      <span class="sm:hidden"><span data-lang="en" hidden>{it.en}</span><span data-lang="el">{it.el}</span></span>
                      <span class="hidden sm:inline">—</span>
                    </span>
                  ))}
                  {r.bundle && (
                    <a href={r.bundle.href} download class="rounded-md border border-gray-300 px-2.5 py-1 text-sm text-gray-700 transition-colors hover:border-accent hover:text-accent dark:border-gray-700 dark:text-gray-300 dark:hover:border-accent-dark dark:hover:text-accent-dark sm:hidden">
                      <svg class="inline-block align-[-4px]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                      <span><span data-lang="en" hidden>All</span><span data-lang="el">Όλα</span></span>
                      <span class="text-xs text-gray-400 dark:text-gray-500">{formatBytes(r.bundle.size)}</span>
                    </a>
                  )}
                </div>
              ) : (
                <span class="mt-1 block text-sm text-gray-400 dark:text-gray-600 sm:col-span-3 sm:mt-0 sm:text-center">
                  <span data-lang="en" hidden>Not yet available</span><span data-lang="el">Μη διαθέσιμο ακόμη</span>
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const toggle = document.getElementById('lang-toggle');

  function apply(lang: 'en' | 'el') {
    document.querySelectorAll<HTMLElement>('[data-lang]').forEach((n) => {
      n.hidden = n.dataset.lang !== lang;
    });
    if (toggle) toggle.textContent = lang === 'en' ? 'GR' : 'EN';
    document.documentElement.lang = lang;
  }

  const KEY = 'teaching-lang-v2';

  let current: 'en' | 'el' = 'el';
  try {
    if (localStorage.getItem(KEY) === 'en') current = 'en';
  } catch {
  }
  apply(current);

  toggle?.addEventListener('click', () => {
    current = current === 'en' ? 'el' : 'en';
    apply(current);
    try {
      localStorage.setItem(KEY, current);
    } catch {
    }
  });

  const tabs = Array.from(document.querySelectorAll<HTMLElement>('[role="tab"]'));
  const ON = ['bg-gray-900', 'text-white', 'border-transparent', 'dark:bg-gray-100', 'dark:text-gray-900'];
  const OFF = ['border-gray-300', 'text-gray-700', 'dark:border-gray-700', 'dark:text-gray-300'];

  function selectTab(name: string) {
    for (const t of tabs) {
      const on = t.id === `tab-${name}`;
      t.setAttribute('aria-selected', String(on));
      ON.forEach((c) => t.classList.toggle(c, on));
      OFF.forEach((c) => t.classList.toggle(c, !on));
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
  }

  tabs.forEach((t) => t.addEventListener('click', () => selectTab(t.id.replace('tab-', ''))));
  selectTab(location.hash === '#slides' ? 'slides' : 'syllabus');
</script>
