---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fileSize } from '../../lib/teaching';

const modules = (await getCollection('teaching', ({ data }) => !data.draft))
  .sort((a, b) => a.data.code.localeCompare(b.data.code));

const rows = modules.map((m) => ({
  module: m,
  available: m.data.lectures.filter((l) => l.file && fileSize(m.id, l.file) !== null).length,
  listed: m.data.lectures.length,
}));
---

<BaseLayout title="Teaching" description="Modules I teach, with lecture material.">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">
    Teaching
  </h1>
  <p class="mt-4 text-gray-600 dark:text-gray-400">
    Modules I teach, with lecture material to download.
  </p>

  <div class="mt-10 space-y-4">
    {rows.map(({ module, available, listed }) => (
      <a
        href={`/teaching/${module.id}/`}
        class="block rounded-lg border border-gray-200 p-5 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:border-gray-800 dark:hover:border-gray-700 dark:hover:bg-gray-900"
      >
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h2 class="font-semibold text-gray-900 dark:text-gray-100">{module.data.title}</h2>
          <span class="shrink-0 text-sm text-gray-500 dark:text-gray-400">{module.data.code}</span>
        </div>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
          {[module.data.department, module.data.institution].filter(Boolean).join(' · ')}
        </p>
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-500">
          {module.data.term}
          {listed > 0 && ` · ${available} of ${listed} ${listed === 1 ? 'lecture' : 'lectures'} available`}
        </p>
      </a>
    ))}
  </div>

  {rows.length === 0 && (
    <p class="mt-10 text-gray-600 dark:text-gray-400">Nothing here yet.</p>
  )}
</BaseLayout>
