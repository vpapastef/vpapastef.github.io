<style is:global>
  a[data-sjr-id][hidden], a[data-scopus-doi][hidden] { display: none !important; } /* the inline-block classes would otherwise beat [hidden] */
  /* fallback when the quartile can't be read: SCImago's widget (200×200, quartile square at x 0–69, y 50–119) cropped to the square, darkened so its white text shows */
  .sjr-tile { display: inline-block; width: 24px; height: 24px; overflow: hidden; border-radius: 4px; flex: none; }
  .sjr-tile img { width: 68.571px; height: 68.571px; max-width: none; margin-top: -17.143px; filter: brightness(.72) contrast(1.5) saturate(.85); }
</style>

<script>
  // Scopus citation counts, read live from PlumX on each visit; nothing is shown if a request fails
  const fmt = new Intl.NumberFormat('en-US');
  const badges = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-scopus-doi]'));
  async function scopus(a: HTMLAnchorElement): Promise<number | null> {
    const doi = a.dataset.scopusDoi!;
    const url = 'https://api.plu.mx/widget/other/artifact?type=doi&id=' + encodeURIComponent(doi) +
      '&href=' + encodeURIComponent('https://plu.mx/plum/a/?doi=' + doi);
    try {
      const r = await fetch(url);
      if (!r.ok) return null;
      const j = await r.json();
      const c = (j?.statistics?.Citations ?? []).find((x: { source?: string }) => x.source === 'Scopus');
      const n = Number(c?.count ?? 0);
      if (n > 0) {
        a.textContent = fmt.format(n) + (n === 1 ? ' citation' : ' citations');
        a.href = 'https://plu.mx/plum/a/?doi=' + encodeURIComponent(doi); // free page, no Scopus sign-in
        a.hidden = false;
      }
      return n;
    } catch {
      return null;
    }
  }
  (async () => {
    const counts = await Promise.all(badges.map(scopus));
    if (!counts.length || counts.some((n) => n === null)) return; // a partial total would mislead
    const sorted = (counts as number[]).slice().sort((x, y) => y - x);
    const box = document.getElementById('scopus-summary')!;
    box.querySelector('[data-total]')!.textContent = fmt.format(sorted.reduce((x, y) => x + y, 0));
    box.querySelector('[data-h]')!.textContent = String(sorted.filter((n, i) => n >= i + 1).length);
    box.hidden = false;
  })();

  // SCImago quartiles, read live: the widget image comes through images.weserv.nl, which adds the CORS
  // header SCImago's own server doesn't send, so the page may read the colour of the quartile square.
  const PILL = 'inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ';
  const QUARTILES: [string, number[], string][] = [
    ['Q1', [164, 207, 99], 'bg-green-100 text-green-800 hover:bg-green-200 dark:bg-green-900/40 dark:text-green-300 dark:hover:bg-green-900/60'],
    ['Q2', [232, 213, 89], 'bg-yellow-100 text-yellow-800 hover:bg-yellow-200 dark:bg-yellow-900/40 dark:text-yellow-300 dark:hover:bg-yellow-900/60'],
    ['Q3', [251, 163, 83], 'bg-orange-100 text-orange-800 hover:bg-orange-200 dark:bg-orange-900/40 dark:text-orange-300 dark:hover:bg-orange-900/60'],
    ['Q4', [221, 90, 78], 'bg-red-100 text-red-800 hover:bg-red-200 dark:bg-red-900/40 dark:text-red-300 dark:hover:bg-red-900/60'],
  ];
  const widget = (id: string) => 'https://www.scimagojr.com/journal_img.php?id=' + id;
  function readQuartile(id: string): Promise<(typeof QUARTILES)[number] | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        try {
          const c = document.createElement('canvas');
          c.width = c.height = 10;
          const ctx = c.getContext('2d')!;
          ctx.drawImage(img, 2, 52, 10, 10, 0, 0, 10, 10); // a corner of the square, clear of the text
          const d = ctx.getImageData(0, 0, 10, 10).data;
          const rgb = [0, 1, 2].map((k) => { let t = 0; for (let i = k; i < d.length; i += 4) t += d[i]; return t / 100; });
          const dist = (q: number[]) => Math.hypot(...q.map((v, k) => v - rgb[k]));
          const best = QUARTILES.reduce((x, y) => (dist(y[1]) < dist(x[1]) ? y : x));
          resolve(dist(best[1]) < 40 ? best : null);
        } catch {
          resolve(null);
        }
      };
      img.onerror = () => resolve(null);
      img.src = 'https://images.weserv.nl/?url=' + encodeURIComponent(widget(id).replace('https://', '')) + '&maxage=1d';
    });
  }
  document.querySelectorAll<HTMLAnchorElement>('a[data-sjr-id]').forEach(async (a) => {
    const q = await readQuartile(a.dataset.sjrId!);
    if (q) {
      a.className = PILL + q[2];
      a.textContent = q[0];
    } else {
      // the relay failed: show SCImago's own image instead, still live
      a.className = 'sjr-tile';
      const img = document.createElement('img');
      img.src = widget(a.dataset.sjrId!);
      img.alt = a.title;
      img.onerror = () => { a.hidden = true; };
      a.replaceChildren(img);
    }
    a.hidden = false;
  });
</script>
