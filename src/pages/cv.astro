---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperEntry from '../components/PaperEntry.astro';
import BookEntry from '../components/BookEntry.astro';
import LiveMetrics from '../components/LiveMetrics.astro';
import { books, journalArticles, conferencePapers } from '../data/publications';
---

<BaseLayout title="CV" description="Curriculum Vitae of Vasilis Papastefanopoulos.">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">
    CV
  </h1>

  <nav aria-label="CV sections" class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
    <a href="#experience" class="hover:text-accent dark:hover:text-accent-dark">Experience</a><span>·</span>
    <a href="#education" class="hover:text-accent dark:hover:text-accent-dark">Education</a><span>·</span>
    <a href="#teaching" class="hover:text-accent dark:hover:text-accent-dark">Teaching</a><span>·</span>
    <a href="#books" class="hover:text-accent dark:hover:text-accent-dark">Books</a><span>·</span>
    <a href="#publications" class="hover:text-accent dark:hover:text-accent-dark">Publications</a><span>·</span>
    <a href="#awards" class="hover:text-accent dark:hover:text-accent-dark">Awards</a><span>·</span>
    <a href="#service" class="hover:text-accent dark:hover:text-accent-dark">Service</a><span>·</span>
    <a href="#open-source" class="hover:text-accent dark:hover:text-accent-dark">Open Source</a>
  </nav>

  <div class="mt-10 space-y-12 text-pretty">
    <section id="experience" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Experience
      </h2>
      <div class="mt-4 space-y-8">

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.pepcogroup.eu/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Pepco Group</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2024-Present</span>
          </div>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Machine learning engineering and applied R&amp;D for large-scale retail data: predictive modelling and downstream analysis.</li>
            <li>Data engineering: automated data collection and processing pipelines.</li>
            <li>A/B testing and causal-inference research: experimentation design, control groups, synthetic controls, and statistical analysis.</li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://datasimply.co/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Data Simply</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2024</span>
          </div>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Contributor to <a href="https://openretailscience.datasimply.co/" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">OpenRetailScience</a>, an open-source Python library for retail data analysis: segmentation methods, statistical analysis, and visualisation.</li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://p.ai/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">P.ai</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2018-2024</span>
          </div>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Predictive ML models for customer behavior (acquisition, retention, and lifetime value) and audience segmentation, over integrated first-party data.</li>
            <li>Multi-cell holdout experiment design and statistical analysis to measure model incrementality and lift.</li>
            <li>An image-to-video pipeline that turned top-performing static ads into short-form videos, combining large language models with a from-scratch PatchMatch implementation (the algorithm behind Adobe's Content-Aware Fill) for image extension to target video dimensions.</li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.crick.ac.uk/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">The Francis Crick Institute</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">Summer 2018</span>
          </div>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Multi-label deep neural networks with learning-to-rank cost functions for protein function prediction.</li>
            <li>Biomedical Data Science Laboratory, under <a href="https://profiles.ucl.ac.uk/8364-david-jones" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Prof. David Jones</a> (Head of the <a href="https://www.ucl.ac.uk/engineering/computer-science/research/research-groups-and-centres/bioinformatics-group" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">UCL Bioinformatics Group</a>).</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="education" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Education
      </h2>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.math.upatras.gr/phd-studies" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Ph.D. in Machine Learning</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2020-2025</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic">University of Patras</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Thesis: <a href="https://www.didaktorika.gr/eadd/handle/10442/59692" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Unsupervised Outlier Detection: New Approaches for Robust Ensembles and Interpretability</a></li>
            <li>Supervisor: <a href="https://www.math.upatras.gr/?section=2174&amp;language=en_US&amp;itemid2354=2720&amp;detail2354=1" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Prof. Sotiris Kotsiantis</a></li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.ucl.ac.uk/prospective-students/graduate/taught-degrees/machine-learning-msc-2026" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">M.Sc. in Machine Learning</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2017-2018</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic">University College London, Distinction</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Thesis: <a href="/projects/multilabel-protein-function/" class="underline hover:text-accent dark:hover:text-accent-dark">Developing a ranking cost function for better multi-label protein function prediction using deep&nbsp;learning</a></li>
            <li>Supervisor: <a href="https://profiles.ucl.ac.uk/8364-david-jones" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Prof. David Jones</a></li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.math.upatras.gr/undergraduate-programs" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">B.Sc. in Mathematics</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2014-2017</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic">University of Patras, 1st</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Thesis: <a href="https://nemertes.library.upatras.gr/items/ac68ca01-be50-4525-b808-e34593886e3f" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Credit Scoring Using Machine Learning</a></li>
            <li>Supervisor: <a href="https://www.math.upatras.gr/?section=2174&amp;language=en_US&amp;itemid2354=2720&amp;detail2354=1" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Prof. Sotiris Kotsiantis</a></li>
          </ul>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.edu-sw.upatras.gr/en/undergraduate-studies/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">B.A. in Education</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2008-2012</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic">University of Patras, 2:1</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>Interdisciplinary studies in psychology, sociology, history, and philosophy of education.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="teaching" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Teaching
      </h2>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.ece.upatras.gr/en/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Department of Electrical and Computer Engineering</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2026-2027</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic">University of Patras, Adjunct Lecturer</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600 dark:text-gray-400 marker:text-gray-300 dark:marker:text-gray-600">
            <li>
              <a href="/teaching/ece-y322/" class="underline hover:text-accent dark:hover:text-accent-dark"><em>Probability &amp; Statistics</em></a> (ECE_Y322)
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section id="books" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Books
      </h2>
      <ol class="mt-4 list-decimal space-y-5 pl-5 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
        {books.map((book) => <BookEntry book={book} />)}
      </ol>
    </section>

    <section id="publications" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Publications
      </h2>
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        Live journal quartiles (best category) from <a href="https://www.scimagojr.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">SCImago Journal Rank</a> and citation counts from <a href="https://www.elsevier.com/products/scopus" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Scopus</a> through <a href="https://www.elsevier.com/insights/metrics/plumx" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">PlumX</a>. Citations per year and the list by type are on the <a href="/publications/" class="underline hover:text-accent dark:hover:text-accent-dark">Publications</a> page.
      </p>
      <p id="scopus-summary" hidden class="mt-2 text-sm text-gray-700 dark:text-gray-300">
        Totals: <strong data-total></strong> citations, h-index <strong data-h></strong> (Scopus)
      </p>
      <ol class="mt-4 list-decimal space-y-5 pl-5 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
        {[...journalArticles, ...conferencePapers].map((paper) => <PaperEntry paper={paper} />)}
      </ol>
    </section>

    <section id="awards" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Awards &amp; Honours
      </h2>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.mdpi.com/about/announcements/11391" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Best Paper Award</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2023</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            From <em>Smart Cities</em> (MDPI), for the review <em>Multivariate Time-Series Forecasting: A Review of Deep Learning Methods in Internet of Things Applications to Smart Cities</em>.
          </p>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://www.mdpi.com/journal/entropy/most_cited" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">Most Cited Paper</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2020</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Most-cited paper in the history of <em>Entropy</em> (MDPI, est. 1999), for <em>Explainable AI: A Review of Machine Learning Interpretability Methods</em>.
          </p>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="http://www.arnaoutisfoundation.com/News.html" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">The General Michael Arnaoutis Foundation Scholarship</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2017</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Postgraduate excellence scholarship awarded to Greek students for studies abroad in technology and related fields. Partially funded my M.Sc. at UCL.
          </p>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">Ranked 3rd in Graduating Class</h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2017</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Third among fourth-year graduates of the Department of Mathematics, University of Patras, from an entering cohort of 372.
          </p>
        </div>

        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">Ministry of Education Scholarship</h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2008</span>
          </div>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Undergraduate excellence scholarship, awarded on the basis of national university entrance examination results.
          </p>
        </div>
      </div>
    </section>

    <section id="service" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Service &amp; Reviewing
      </h2>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">Guest Editor Assistant</h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2026-Present</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 italic"><em>Entropy</em> (MDPI)</p>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Special Issue: <a href="https://www.mdpi.com/journal/entropy/special_issues/7V771408WY" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark"><em>Explainable Artificial Intelligence for Complex and Data-Driven Systems: Methods, Evaluation, and Applications</em></a>. With <a href="https://www.math.upatras.gr/?section=2174&amp;language=en_US&amp;itemid2354=2720&amp;detail2354=1" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent dark:hover:text-accent-dark">Prof. Sotiris Kotsiantis</a> as Guest Editor.
          </p>
        </div>
      </div>
    </section>

    <section id="open-source" class="scroll-mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
        Open Source Contributions
      </h2>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100">
              <a href="https://openretailscience.datasimply.co/" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">OpenRetailScience</a>
            </h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">2024</span>
          </div>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            Contributor to an open-source Python library for retail data analysis, with a focus on segmentation methods, statistical analysis, and visualisation.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<LiveMetrics />
